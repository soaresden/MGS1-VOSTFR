+// Mods page: one switch per installed mod feature and one row per choice
+// option, from a snapshot of the runtime's mod catalogue taken at attach (main
+// thread; the catalogue is never read from the draw thread). A change is saved
+// through mod_set to mods/state.toml and takes effect at the next start, or
+// live for the options a plugin applies at once. The menu is the only writer
+// during a session, so the snapshot stays true while it runs.
+struct ModRow {
+    std::string key, package, feature, option, label, description;
+    std::vector<std::string> values, labels;
+    std::vector<const char *> choice_ptrs;
+    int value = 0;  // feature: 0/1; option: index into values
+};
+std::vector<ModRow> g_mod_rows;
+std::vector<RecompRuntimeUiItem> g_items;  // g_extra rows in use + the mod rows
+
+#if defined(PSX_MENU_HOST_HAS_MOD_CATALOG)
+// Built-in runtime preferences have their own rows (Graphics, Display): the
+// same packages the launcher shows under Settings instead of Mods.
+bool settings_package(const char *id) {
+    static const char *const kSettings[] = {
+        "psx.enhancement.crt-filter", "psx.enhancement.image-filtering",
+        "psx.enhancement.internal-resolution", "psx.enhancement.pgxp",
+        "psx.enhancement.enhanced-audio", "psx.feature.rewind", "psx.runtime.settings"};
+    for (const char *s : kSettings)
+        if (!std::strcmp(id, s)) return true;
+    return false;
+}
+
+void snapshot_mods() {
+    g_mod_rows.clear();
+    const RecompLauncherCModProvider *mods =
+        g_host && g_host->mod_catalog ? g_host->mod_catalog() : nullptr;
+    if (!mods || !mods->feature_count || !mods->feature_get || !g_host->mod_set) return;
+    // Only the packages that are switched on run: a title may ship one package
+    // per disc with the same features (only the mounted disc's is enabled).
+    std::vector<std::string> on;
+    const bool by_package = mods->package_count && mods->package_get;
+    if (by_package) {
+        for (int i = 0, n = mods->package_count(mods->ctx); i < n; ++i) {
+            RecompLauncherCModPackage pkg{};
+            if (mods->package_get(mods->ctx, i, &pkg) && pkg.enabled) on.push_back(pkg.id);
+        }
+    }
+    for (int i = 0, n = mods->feature_count(mods->ctx); i < n; ++i) {
+        RecompLauncherCModFeature f{};
+        if (!mods->feature_get(mods->ctx, i, &f) || settings_package(f.package_id)) continue;
+        if (f.hidden && (!f.enabled || mods->hide_hidden_features)) continue;
+        if (f.channel == RECOMP_MOD_CHANNEL_DEVELOPER) continue;
+        bool pkg_on = !by_package;
+        for (const auto &id : on) pkg_on = pkg_on || id == f.package_id;
+        if (!pkg_on) continue;
+        ModRow row;
+        row.key = "mods.feature." + std::to_string(g_mod_rows.size());
+        row.package = f.package_id;
+        row.feature = f.id;
+        row.label = f.name[0] ? f.name : f.id;
+        row.description = f.description;
+        row.value = f.enabled ? 1 : 0;
+        g_mod_rows.push_back(row);
+        if (!mods->feature_option_get || !mods->feature_choice_get) continue;
+        for (int o = 0; o < f.option_count; ++o) {
+            RecompLauncherCModOption opt{};
+            if (!mods->feature_option_get(mods->ctx, f.package_id, f.id, o, &opt) ||
+                opt.type != RECOMP_MOD_OPTION_CHOICE || opt.choice_count < 1) continue;
+            ModRow orow;
+            orow.key = "mods.option." + std::to_string(g_mod_rows.size());
+            orow.package = f.package_id;
+            orow.feature = f.id;
+            orow.option = opt.id;
+            orow.label = row.label + ": " + (opt.label[0] ? opt.label : opt.id);
+            orow.description = opt.description;
+            for (int c = 0; c < opt.choice_count; ++c) {
+                RecompLauncherCModChoice ch{};
+                if (!mods->feature_choice_get(mods->ctx, f.package_id, f.id, opt.id, c, &ch)) continue;
+                if (!std::strcmp(ch.value, opt.value)) orow.value = (int)orow.values.size();
+                orow.values.push_back(ch.value);
+                orow.labels.push_back(ch.label[0] ? ch.label : ch.value);
+            }
+            if (!orow.values.empty()) g_mod_rows.push_back(orow);
+        }
+    }
+}
+#else
+void snapshot_mods() { g_mod_rows.clear(); }
+#endif
+
+ModRow *mod_row(const RecompRuntimeUiItem *item) {
+    if (!item || !item->key || std::strncmp(item->key, "mods.", 5)) return nullptr;
+    for (auto &row : g_mod_rows)
+        if (row.key == item->key) return &row;
+    return nullptr;
+}
