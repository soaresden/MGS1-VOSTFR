+    const int32_t cl = l < base ? base : l, cr = r > base + W - 1 ? base + W - 1 : r;
+    gr_set_draw_area((int)cl, (int)draw_area_top, (int)cr, (int)draw_area_bottom);
+    int32_t pad_l = l - base + off, pad_r = wide_w - (r - base + off + 1);
+    if (pad_l < 0) pad_l = 0;
+    if (pad_r < 0) pad_r = 0;
+    gr_wide_set_view(2, 0, (int)pad_l, (int)pad_r);   /* 2: X clip only */
+}
