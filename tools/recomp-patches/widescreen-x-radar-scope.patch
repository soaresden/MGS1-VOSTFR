+/* A scope or goggles mask made of opaque black quads that run from the
+ * opening's edge out to the side of the 4:3 frame (MGS's PSG1 and binoculars:
+ * ~40 trapezoids, each with two vertices on x = 0 or x = 320). Native-wide
+ * showed the world in the bands beside it. Continue each such quad across the
+ * band with a black rectangle as tall as its frame-side edge, in the quad's own
+ * place in the list (canonical VRAM clips it away). PSX_WS_EDGE_MASKS=1. */
+static void ws_nw_edge_mask_bands(const int32_t *vx, const int32_t *vy, uint16_t color) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("PSX_WS_EDGE_MASKS"); on = e && *e == '1'; }
+    if (!on || (color & 0x7FFFu) || !ws_native_wide_active()) return;
