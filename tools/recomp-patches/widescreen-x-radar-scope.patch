+        const int32_t ex = side ? W : 0;
+        int n = 0;
+        int32_t y0 = INT32_MAX, y1 = INT32_MIN;
+        for (int i = 0; i < 4; i++) {
+            if (vx[i] != ex) continue;
+            n++;
+            if (vy[i] < y0) y0 = vy[i];
+            if (vy[i] > y1) y1 = vy[i];
+        }
+        if (n < 2 || y1 <= y0) continue;
+        gr_set_semi_transparency(0, (int)semi_transparency);
+        gr_draw_flat_rect((side ? W : -m) + draw_offset_x, y0 + draw_offset_y,
+                          (int)m, (int)(y1 - y0), color);
+    }
+}
