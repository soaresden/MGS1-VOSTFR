+/* A HUD packet's small draw area in an outer third of a frame buffer (see
+ * ws_nw_subarea_dx): returns the shift, and the buffer in *out_base. */
+static int32_t ws_nw_subarea_shift(int32_t *out_base) {
+    if (!ws_native_wide_active() || !ws_nw_left_hud_packet()) return 0;
+    const int32_t off = ws_nw_offset(), W = ws_disp_w(), H = ws_disp_h();
+    if (off <= 0 || W <= 0) return 0;
+    const int32_t l = (int32_t)draw_area_left, r = (int32_t)draw_area_right;
+    const int32_t t = (int32_t)draw_area_top, b = (int32_t)draw_area_bottom;
+    if (r <= l || b <= t || r - l + 1 > W / 2 || b - t + 1 > H / 2) return 0;
+    for (int i = 0; i < ws_fb_n; i++) {
+        const int32_t base = (int32_t)ws_fb_base[i];
+        if (l <= base || r >= base + W) continue;   /* a full buffer, or not in this one */
+        const int32_t cx = 2 * (l - base) + (r - l);
+        int32_t d = 0;
+        if (3 * cx < 2 * W) d = -off;
+        else if (3 * cx > 4 * W) d = off;
+        if (d) *out_base = base;
+        return d;
+    }
+    return 0;
+}
